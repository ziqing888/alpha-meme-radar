{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-meme-radar.local/contracts/execution.signal.v1.schema.json",
  "title": "Execution Signal V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "signal_id", "chain", "contract_address", "observed_at", "published_at", "source_provenance"],
  "properties": {
    "schema_version": { "const": "execution.signal.v1" },
    "signal_id": { "type": "string", "minLength": 1 },
    "chain": { "type": "string", "minLength": 1 },
    "contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": "string", "format": "date-time" },
    "source_provenance": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "monitor_stage": { "type": "string" },
    "strategy_id": { "type": ["string", "null"] }
  }
}
